---
import PublicLayout from '../layouts/PublicLayout.astro';
import Icon from './Icon.astro';
import {
  t,
  localizedPath,
  getServices,
  getPortfolio,
  getWhatsAppHref,
  stats,
  testimonials,
  homeInsights,
  type Lang,
} from '../data/bms';

interface Props {
  lang?: Lang;
}

const { lang = 'id' } = Astro.props;
const currentPath = lang === 'en' ? '/en' : '/';
const services = getServices(lang);
const portfolio = getPortfolio(lang).slice(0, 4);

const heroWaHref = getWhatsAppHref(currentPath, lang, { refCode: '0ILRII' });
const ctaWaHref = getWhatsAppHref(currentPath, lang, { refCode: 'B8LP4R' });

const whyItems = [
  {
    icon: 'ShieldCheck',
    title: t('why.item.cert.title', lang),
    desc: t('why.item.cert.desc', lang),
  },
  {
    icon: 'Clock',
    title: t('why.item.ontime.title', lang),
    desc: t('why.item.ontime.desc', lang),
  },
  {
    icon: 'Lock',
    title: t('why.item.security.title', lang),
    desc: t('why.item.security.desc', lang),
  },
  {
    icon: 'Headphones',
    title: t('why.item.support.title', lang),
    desc: t('why.item.support.desc', lang),
  },
];

const statKeys = ['stats.projects', 'stats.satisfaction', 'stats.team'];
---

<PublicLayout
  lang={lang}
  currentPath={currentPath}
  title={t('home.seo_title', lang)}
  description={t('home.seo_desc', lang)}
>
  <!-- 1. Hero Section -->
  <section class="relative min-h-[92vh] flex items-center overflow-hidden">
    <img
      src="/home/hero-bg.webp"
      alt=""
      aria-hidden="true"
      width="1920"
      height="1080"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover will-change-transform motion-reduce:!scale-100 motion-reduce:!translate-y-0"
      style="transform: scale(1.02);"
    />
    <div class="overflow-hidden -z-10 absolute inset-0 opacity-60 mix-blend-screen" aria-hidden="true">
      <div class="absolute inset-0 gradient-mesh opacity-90"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-background/40"></div>
      <div
        class="absolute -top-20 -left-20 hidden h-[40rem] w-[40rem] rounded-full bg-brand-blue/40 blur-[120px] animate-blob lg:block motion-reduce:hidden"
      >
      </div>
      <div
        class="absolute top-1/3 -right-20 hidden h-[35rem] w-[35rem] rounded-full bg-brand-pink/40 blur-[120px] animate-blob xl:block motion-reduce:hidden"
        style="animation-delay: 5s;"
      >
      </div>
      <div
        class="absolute -bottom-20 left-1/3 hidden h-[30rem] w-[30rem] rounded-full bg-brand-cyan/40 blur-[120px] animate-blob xl:block motion-reduce:hidden"
        style="animation-delay: 10s;"
      >
      </div>
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-brand-navy/40 via-brand-navy/20 to-brand-navy/60"></div>

    <svg
      viewBox="0 0 400 400"
      class="pointer-events-none opacity-20 absolute right-10 top-1/4 h-96 w-96 text-white"
      aria-hidden="true"
    >
      <circle cx="200" cy="200" r="40" fill="none" stroke="currentColor" stroke-width="1"></circle>
      <circle cx="200" cy="200" r="80" fill="none" stroke="currentColor" stroke-width="1"></circle>
      <circle cx="200" cy="200" r="120" fill="none" stroke="currentColor" stroke-width="1"></circle>
      <circle cx="200" cy="200" r="160" fill="none" stroke="currentColor" stroke-width="1"></circle>
      <circle cx="200" cy="200" r="200" fill="none" stroke="currentColor" stroke-width="1"></circle>
    </svg>
    <svg
      viewBox="0 0 400 400"
      class="pointer-events-none opacity-20 absolute -left-20 bottom-10 h-80 w-80 text-white"
      aria-hidden="true"
    >
      <circle cx="200" cy="200" r="40" fill="none" stroke="currentColor" stroke-width="1"></circle>
      <circle cx="200" cy="200" r="80" fill="none" stroke="currentColor" stroke-width="1"></circle>
      <circle cx="200" cy="200" r="120" fill="none" stroke="currentColor" stroke-width="1"></circle>
      <circle cx="200" cy="200" r="160" fill="none" stroke="currentColor" stroke-width="1"></circle>
      <circle cx="200" cy="200" r="200" fill="none" stroke="currentColor" stroke-width="1"></circle>
    </svg>

    <div class="container mx-auto px-4 relative z-10 py-20">
      <div class="max-w-4xl" data-reveal>
        <div
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass-card text-sm font-medium text-brand-navy mb-6"
        >
          <Icon name="Sparkles" size={14} class="text-brand-blue" />
          {t('home.hero_badge', lang)}
        </div>
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-extrabold leading-[1.05] tracking-tight text-white drop-shadow-md"
        >
          {t('home.hero_title_a', lang)}<br />
          <span
            class="bg-gradient-to-r from-white via-brand-lavender to-white bg-clip-text text-transparent"
          >
            {t('home.hero_title_b', lang)}
          </span>
        </h1>
        <p class="mt-6 text-lg md:text-xl text-white/90 max-w-2xl leading-relaxed">
          {t('home.hero_subtitle', lang)}
        </p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4">
          <a
            href={heroWaHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 whitespace-nowrap ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 w-full sm:w-auto rounded-full bg-white text-brand-navy hover:bg-white/90 font-semibold px-8 h-14 text-base shadow-xl"
          >
            {t('home.hero_cta_primary', lang)}
            <Icon name="ArrowRight" size={18} class="ml-2" />
          </a>
          <a
            class="inline-flex items-center justify-center gap-2 whitespace-nowrap ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 border w-full sm:w-auto rounded-full bg-white/10 text-white border-white/30 hover:bg-white/20 hover:text-white backdrop-blur-md font-semibold px-8 h-14 text-base"
            href={localizedPath('/portofolio', lang)}
          >
            {t('home.hero_cta_secondary', lang)}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Services Grid -->
  <section class="py-24 relative overflow-hidden">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mb-16">
        <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue mb-3">
          {t('services_grid.eyebrow', lang)}
        </p>
        <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight">
          {t('services_grid.title_a', lang)}{' '}
          <span class="gradient-text">{t('services_grid.title_b', lang)}</span>{' '}
          {t('services_grid.title_c', lang)}
        </h2>
        <p class="mt-4 text-lg text-muted-foreground">
          {t('services_grid.subtitle', lang)}
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((svc) => (
          <div class="group premium-card p-7">
            <div class="w-14 h-14 rounded-2xl gradient-mesh flex items-center justify-center text-white mb-5 group-hover:scale-110 transition-transform">
              <Icon name={svc.icon} size={26} />
            </div>
            <h3 class="text-xl font-bold mb-2">
              {svc.slug === 'custom-software-solutions' && lang === 'id'
                ? 'Custom Software'
                : svc.title}
            </h3>
            <p class="text-muted-foreground text-sm leading-relaxed mb-5">{svc.short}</p>
            <a
              class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:gap-2 transition-all"
              href={localizedPath(`/layanan/${svc.slug}`, lang)}
            >
              {t('services_grid.learn_more', lang)} <Icon name="ArrowRight" size={14} />
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Why BMS Section -->
  <section class="py-24 relative overflow-hidden bg-secondary/40">
    <svg
      viewBox="0 0 600 600"
      xmlns="http://www.w3.org/2000/svg"
      class="pointer-events-none animate-blob blur-3xl opacity-60 absolute -top-40 -right-40 w-[40rem] h-[40rem]"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="blob-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="hsl(var(--brand-blue))"></stop>
          <stop offset="50%" stop-color="hsl(var(--brand-cyan))"></stop>
          <stop offset="100%" stop-color="hsl(var(--brand-pink))"></stop>
        </linearGradient>
      </defs>
      <path
        fill="url(#blob-gradient)"
        d="M421,326Q401,402,326,432Q251,462,176,419Q101,376,89,288Q77,200,143,140Q209,80,295,89Q381,98,425,174Q469,250,421,326Z"
      ></path>
    </svg>
    <div class="container mx-auto px-4 relative">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue mb-3">
            {t('why.eyebrow', lang)}
          </p>
          <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight">
            {t('why.title_a', lang)}{' '}
            <span class="gradient-text">{t('why.title_b', lang)}</span>
          </h2>
          <p class="mt-4 text-lg text-muted-foreground">{t('why.subtitle', lang)}</p>
        </div>
        <div class="grid sm:grid-cols-2 gap-5">
          {whyItems.map((item) => (
            <div class="glass-card rounded-2xl p-6" data-reveal>
              <div class="w-12 h-12 rounded-xl bg-brand-blue/10 flex items-center justify-center text-brand-blue mb-4">
                <Icon name={item.icon} size={22} />
              </div>
              <h3 class="font-bold text-lg mb-1">{item.title}</h3>
              <p class="text-sm text-muted-foreground leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Portfolio Preview -->
  <section class="py-20 md:py-24">
    <div class="container mx-auto px-4">
      <div
        class="mb-10 flex flex-col gap-5 md:mb-12 md:flex-row md:flex-wrap md:items-end md:justify-between md:gap-6"
      >
        <div class="max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue mb-3">
            {t('portfolio_preview.eyebrow', lang)}
          </p>
          <h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl md:text-5xl">
            {t('portfolio_preview.title_a', lang)}{' '}
            <span class="gradient-text">{t('portfolio_preview.title_b', lang)}</span>
          </h2>
        </div>
        <a
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2 w-full sm:w-auto rounded-full"
          href={localizedPath('/portofolio', lang)}
        >
          {t('portfolio_preview.cta', lang)}
          <Icon name="ArrowRight" size={16} class="ml-1" />
        </a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 xl:gap-6">
        {portfolio.map((item) => (
          <div class="group flex h-full flex-col overflow-hidden premium-card" data-reveal>
            <div class="aspect-[16/10] sm:aspect-video bg-gradient-to-br from-brand-blue/20 via-brand-cyan/20 to-brand-pink/20 overflow-hidden p-3 sm:p-4">
              <img
                src={item.image_url}
                alt={item.title}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-contain object-center transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <div class="flex flex-1 flex-col p-5 sm:p-6">
              <span class="text-xs font-semibold uppercase tracking-wider text-brand-blue">
                {item.category}
              </span>
              <h3 class="text-xl font-bold mt-1 mb-2">{item.title}</h3>
              <p class="text-sm text-muted-foreground line-clamp-3">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Testimonials -->
  <section class="py-24 relative overflow-hidden bg-secondary/40">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue mb-3">
          {t('testimonials.eyebrow', lang)}
        </p>
        <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight">
          {t('testimonials.title_a', lang)}{' '}
          <span class="gradient-text">{t('testimonials.title_b', lang)}</span>
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {testimonials.map((item) => (
          <div class="relative premium-card p-7" data-reveal>
            <Icon name="Quote" size={48} class="absolute top-6 right-6 text-brand-blue/15" />
            <div class="flex gap-1 mb-4">
              {Array.from({ length: item.rating }).map(() => (
                <Icon name="Star" size={16} class="fill-amber-400 text-amber-400" />
              ))}
            </div>
            <p class="text-foreground/85 leading-relaxed mb-6 relative z-10">"{item.quote}"</p>
            <div class="flex items-center gap-3 pt-4 border-t border-border">
              <div class="w-11 h-11 rounded-full gradient-mesh flex items-center justify-center text-white font-bold">
                {item.name.charAt(0)}
              </div>
              <div>
                <p class="font-semibold text-sm">{item.name}</p>
                <p class="text-xs text-muted-foreground">
                  {item.role} · {item.company}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="grid sm:grid-cols-2 gap-4 mt-10 max-w-2xl mx-auto">
        <div class="flex items-center justify-center h-32" data-reveal>
          <a
            href="https://www.sortlist.com/agency/bms-services"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img
              alt="Click here to view the agency's profile on Sortlist"
              src="https://www.sortlist.com/widget/bms-services/review?ref=review-widget-1"
              style="width: 512px; height: 128px; max-width: 100%;"
            />
          </a>
        </div>
        <div class="flex items-center gap-3 h-24" data-reveal>
          <div
            class="w-10 h-10 rounded-full bg-white flex items-center justify-center shadow-sm shrink-0"
          >
            <svg viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true">
              <path
                fill="#4285F4"
                d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
              ></path>
              <path
                fill="#34A853"
                d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
              ></path>
              <path
                fill="#FBBC05"
                d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
              ></path>
              <path
                fill="#EA4335"
                d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
              ></path>
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <a
              href="https://share.google/f3jAMeSoVlnJBQbmJ"
              target="_blank"
              rel="noopener noreferrer"
              class="group block"
            >
              <p
                class="font-semibold text-sm text-foreground group-hover:text-brand-blue transition-colors truncate"
              >
                Google Reviews
              </p>
              <div class="flex items-center gap-1.5 mt-0.5">
                <span class="text-xl font-extrabold text-foreground">5.0</span>
                <div class="flex gap-0.5">
                  {Array.from({ length: 5 }).map(() => (
                    <Icon name="Star" size={14} class="fill-amber-400 text-amber-400" />
                  ))}
                </div>
              </div>
              <p class="text-xs text-muted-foreground mt-0.5">3 reviews</p>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Stats Banner -->
  <section class="py-20">
    <div class="container mx-auto px-4">
      <div class="rounded-3xl gradient-mesh p-10 md:p-14 relative overflow-hidden">
        <div
          class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(255,255,255,0.2),transparent_50%)]"
        >
        </div>
        <div class="grid md:grid-cols-3 gap-8 relative">
          {stats.map((st, idx) => (
            <div class="text-center text-white" data-reveal>
              <p class="text-5xl md:text-6xl font-extrabold tracking-tight">
                <span data-count-to={String(st.value)} data-count-suffix={st.suffix}>
                  {Number.isInteger(st.value) ? st.value : st.value.toFixed(1)}
                  {st.suffix}
                </span>
              </p>
              <p class="mt-2 text-white/80 font-medium">
                {t(statKeys[idx] ?? 'stats.projects', lang)}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Insights / Blog Preview -->
  <section class="py-20 md:py-24">
    <div class="container mx-auto px-4">
      <div
        class="mb-10 flex flex-col gap-5 md:mb-12 md:flex-row md:flex-wrap md:items-end md:justify-between md:gap-6"
      >
        <div class="max-w-2xl">
          <p
            class="text-sm font-semibold uppercase tracking-wider text-brand-blue mb-3 inline-flex items-center gap-2"
          >
            <Icon name="BookOpen" size={14} />Insights
          </p>
          <h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl md:text-5xl">
            Artikel <span class="gradient-text">terbaru</span> dari tim BMS
          </h2>
        </div>
        <a
          href={localizedPath('/blog', lang)}
          class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline"
        >
          Lihat semua artikel <Icon name="ArrowRight" size={16} />
        </a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4 xl:gap-6">
        {homeInsights.map((post) => (
          <a
            href={localizedPath(post.href, lang)}
            class="group flex h-full flex-col premium-card p-6 transition-transform hover:-translate-y-1"
          >
            <span class="text-xs font-semibold uppercase tracking-wider text-brand-blue">Blog</span>
            <h3 class="mt-2 text-lg font-bold leading-snug group-hover:text-brand-blue">
              {post.anchor}
            </h3>
            <p class="mt-2 text-sm text-muted-foreground line-clamp-3">{post.description}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-blue">
              Baca artikel{' '}
              <Icon
                name="ArrowRight"
                size={14}
                class="transition-transform group-hover:translate-x-1"
              />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. CTA Banner -->
  <section class="py-20">
    <div class="container mx-auto px-4">
      <div class="relative rounded-3xl bg-brand-navy p-12 md:p-16 text-center overflow-hidden">
        <svg
          viewBox="0 0 600 600"
          xmlns="http://www.w3.org/2000/svg"
          class="pointer-events-none animate-blob blur-3xl opacity-60 absolute -top-20 -left-20 w-96 h-96"
          aria-hidden="true"
        >
          <defs>
            <linearGradient id="blob-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="hsl(var(--brand-blue))"></stop>
              <stop offset="50%" stop-color="hsl(var(--brand-cyan))"></stop>
              <stop offset="100%" stop-color="hsl(var(--brand-pink))"></stop>
            </linearGradient>
          </defs>
          <path
            fill="hsl(var(--brand-blue) / 0.5)"
            d="M421,326Q401,402,326,432Q251,462,176,419Q101,376,89,288Q77,200,143,140Q209,80,295,89Q381,98,425,174Q469,250,421,326Z"
          ></path>
        </svg>
        <svg
          viewBox="0 0 600 600"
          xmlns="http://www.w3.org/2000/svg"
          class="pointer-events-none animate-blob blur-3xl opacity-60 absolute -bottom-20 -right-20 w-96 h-96"
          aria-hidden="true"
        >
          <defs>
            <linearGradient id="blob-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="hsl(var(--brand-blue))"></stop>
              <stop offset="50%" stop-color="hsl(var(--brand-cyan))"></stop>
              <stop offset="100%" stop-color="hsl(var(--brand-pink))"></stop>
            </linearGradient>
          </defs>
          <path
            fill="hsl(var(--brand-pink) / 0.5)"
            d="M421,326Q401,402,326,432Q251,462,176,419Q101,376,89,288Q77,200,143,140Q209,80,295,89Q381,98,425,174Q469,250,421,326Z"
          ></path>
        </svg>
        <div class="relative">
          <h2 class="text-3xl md:text-5xl font-extrabold text-white max-w-2xl mx-auto leading-tight">
            {t('cta.title', lang)}
          </h2>
          <p class="mt-4 text-white/80 max-w-xl mx-auto">{t('cta.subtitle', lang)}</p>
          <a
            href={ctaWaHref}
            target="_blank"
            rel="noopener noreferrer"
