---
import PublicLayout from '../layouts/PublicLayout.astro';
import Icon from './Icon.astro';
import { t, localizedPath, getPortfolio, getWhatsAppHref, type Lang } from '../data/bms';

interface Props {
  lang?: Lang;
}

const { lang = 'id' } = Astro.props;
const currentPath = localizedPath('/portofolio', lang);
const portfolio = getPortfolio(lang);
const categories = ['All', ...Array.from(new Set(portfolio.map((p) => p.category)))];
const waHref = getWhatsAppHref('/portofolio', lang);
---

<PublicLayout
  lang={lang}
  currentPath={currentPath}
  title={`${t('portfolio_preview.eyebrow', lang)} — BMS Services`}
  description={t('home.seo_desc', lang)}
>
  <section class="py-20 md:py-28 bg-secondary/40">
    <div class="container mx-auto px-4 text-center max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue mb-3">
        {t('portfolio_preview.eyebrow', lang)}
      </p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight">
        {t('portfolio_preview.title_a', lang)}{' '}
        <span class="gradient-text">{t('portfolio_preview.title_b', lang)}</span>
      </h1>
      <div class="mt-8 flex flex-wrap justify-center gap-2" id="portfolio-filters">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-filter={cat}
            class={`px-4 py-2 rounded-full text-sm font-semibold transition-colors ${
              idx === 0
                ? 'bg-brand-navy text-white'
                : 'bg-background border border-border text-foreground/70 hover:text-foreground'
            }`}
          >
            {cat === 'All' ? (lang === 'en' ? 'All Projects' : 'Semua Project') : cat}
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="container mx-auto px-4">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="portfolio-grid">
        {portfolio.map((item) => (
          <div
            data-category={item.category}
            class="portfolio-item group flex h-full flex-col overflow-hidden premium-card"
            data-reveal
          >
            <div class="aspect-[16/10] bg-gradient-to-br from-brand-blue/20 via-brand-cyan/20 to-brand-pink/20 overflow-hidden p-4">
              <img
                src={item.image_url}
                alt={item.title}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-contain object-center transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <span class="text-xs font-semibold uppercase tracking-wider text-brand-blue">
                {item.category}
              </span>
              <h2 class="text-xl font-bold mt-1 mb-2">{item.title}</h2>
              <p class="text-sm text-muted-foreground leading-relaxed mb-4 flex-1">
                {item.description}
              </p>
              {item.results && item.results.length > 0 && (
                <div class="flex flex-wrap gap-1.5 pt-3 border-t border-border">
                  {item.results.slice(0, 2).map((res: string) => (
                    <span class="text-[11px] font-medium px-2.5 py-1 rounded-full bg-secondary text-brand-navy">
                      {res}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container mx-auto px-4">
      <div class="relative rounded-3xl bg-brand-navy p-12 md:p-16 text-center overflow-hidden">
        <h2 class="text-3xl md:text-5xl font-extrabold text-white max-w-2xl mx-auto leading-tight">
          {t('cta.title', lang)}
        </h2>
        <p class="mt-4 text-white/80 max-w-xl mx-auto">{t('cta.subtitle', lang)}</p>
        <a
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 mt-8 rounded-full bg-white text-brand-navy hover:bg-white/90 font-semibold h-14 px-8"
        >
          {t('cta.button', lang)} <Icon name="ArrowRight" size={18} class="ml-2" />
        </a>
      </div>
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('#portfolio-filters button');
    const cards = document.querySelectorAll<HTMLElement>('#portfolio-grid .portfolio-item');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter || 'All';
        buttons.forEach((b) => {
          b.className =
            b === btn
              ? 'px-4 py-2 rounded-full text-sm font-semibold transition-colors bg-brand-navy text-white'
              : 'px-4 py-2 rounded-full text-sm font-semibold transition-colors bg-background border border-border text-foreground/70 hover:text-foreground';
        });
        cards.forEach((card) => {
          const match = filter === 'All' || card.dataset.category === filter;
          card.style.display = match ? '' : 'none';
        });
      });
    });
  </script>
</PublicLayout>
