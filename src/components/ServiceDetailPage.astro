---
import PublicLayout from '../layouts/PublicLayout.astro';
import Icon from './Icon.astro';
import {
  t,
  localizedPath,
  getServices,
  getWhatsAppHref,
  type Lang,
  type ServiceItem,
} from '../data/bms';

interface Props {
  service: ServiceItem;
  lang?: Lang;
}

const { service, lang = 'id' } = Astro.props;
const currentPath = localizedPath(`/layanan/${service.slug}`, lang);
const waHref = getWhatsAppHref(currentPath, lang, { serviceTitle: service.title });
const otherServices = getServices(lang)
  .filter((s) => s.slug !== service.slug)
  .slice(0, 3);
---

<PublicLayout
  lang={lang}
  currentPath={currentPath}
  title={`${service.title} — BMS Services`}
  description={service.short}
  hideFloatingWa={true}
>
  <!-- Hero -->
  <section class="relative py-20 md:py-28 overflow-hidden bg-brand-navy text-white">
    <div class="overflow-hidden absolute inset-0 opacity-40 mix-blend-screen" aria-hidden="true">
      <div class="absolute inset-0 gradient-mesh opacity-80"></div>
    </div>
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-3xl" data-reveal>
        <div class="w-14 h-14 rounded-2xl gradient-mesh flex items-center justify-center text-white mb-6">
          <Icon name={service.icon} size={28} />
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight tracking-tight">
          {service.title}
        </h1>
        <p class="mt-6 text-lg md:text-xl text-white/85 leading-relaxed">
          {service.description}
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href={waHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-full bg-white text-brand-navy hover:bg-white/90 font-semibold px-8 h-14 text-base shadow-xl"
          >
            {t('home.hero_cta_primary', lang)}
            <Icon name="ArrowRight" size={18} class="ml-2" />
          </a>
          <a
            href={localizedPath('/portofolio', lang)}
            class="inline-flex items-center justify-center gap-2 rounded-full bg-white/10 text-white border border-white/30 hover:bg-white/20 font-semibold px-8 h-14 text-base"
          >
            {t('home.hero_cta_secondary', lang)}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Signs & Benefits -->
  <section class="py-20">
    <div class="container mx-auto px-4 grid lg:grid-cols-2 gap-10">
      {service.signs && service.signs.length > 0 && (
        <div class="premium-card p-8" data-reveal>
          <h2 class="text-2xl md:text-3xl font-extrabold mb-6">
            {t('svc.signs_title_a', lang)}{' '}
            <span class="gradient-text">{t('svc.signs_title_b', lang)}</span>
          </h2>
          <ul class="space-y-4">
            {service.signs.map((sign) => (
              <li class="flex items-start gap-3">
                <Icon name="CheckCircle2" size={20} class="text-brand-blue mt-0.5 shrink-0" />
                <span class="text-foreground/85">{sign}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {service.benefits && service.benefits.length > 0 && (
        <div class="premium-card p-8" data-reveal>
          <h2 class="text-2xl md:text-3xl font-extrabold mb-6">
            {t('svc.solution_title_a', lang)}{' '}
            <span class="gradient-text">{t('svc.solution_title_b', lang)}</span>
          </h2>
          <ul class="space-y-4">
            {service.benefits.map((benefit) => (
              <li class="flex items-start gap-3">
                <Icon name="Sparkles" size={20} class="text-brand-blue mt-0.5 shrink-0" />
                <span class="text-foreground/85">{benefit}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <!-- Process -->
  {service.process && service.process.length > 0 && (
    <section class="py-20 bg-secondary/40">
      <div class="container mx-auto px-4">
        <div class="max-w-2xl mb-12">
          <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight">
            {t('svc.process_title_a', lang)}{' '}
            <span class="gradient-text">{t('svc.process_title_b', lang)}</span>
          </h2>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {service.process.map((step, idx) => (
            <div class="premium-card p-6" data-reveal>
              <div class="w-10 h-10 rounded-xl gradient-mesh text-white font-bold flex items-center justify-center mb-4">
                {idx + 1}
              </div>
              <h3 class="font-bold text-lg mb-2">{step.step}</h3>
              <p class="text-sm text-muted-foreground leading-relaxed">{step.desc}</p>
              {step.deliverable && (
                <p class="mt-4 pt-3 border-t border-border text-xs font-medium text-brand-blue">
                  {t('svc.deliverable_label', lang)} {step.deliverable}
                </p>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQs -->
  {service.faqs && service.faqs.length > 0 && (
    <section class="py-20">
      <div class="container mx-auto px-4 max-w-3xl">
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-center mb-12">
          {t('svc.faq_title_a', lang)}{' '}
          <span class="gradient-text">{t('svc.faq_title_b', lang)}</span>
        </h2>
        <div class="space-y-4">
          {service.faqs.map((faq) => (
            <details class="premium-card p-6 group">
              <summary class="font-bold text-lg cursor-pointer list-none flex items-center justify-between gap-4">
                <span>{faq.q}</span>
                <Icon
                  name="ChevronDown"
                  size={18}
                  class="transition-transform group-open:rotate-180 shrink-0"
                />
              </summary>
              <p class="mt-3 text-sm text-muted-foreground leading-relaxed">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Related Services -->
  <section class="py-16 bg-secondary/40">
    <div class="container mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-extrabold mb-8">
        {t('svc.related_title_a', lang)}{' '}
        <span class="gradient-text">{t('svc.related_title_b', lang)}</span>
      </h2>
      <div class="grid md:grid-cols-3 gap-6">
        {otherServices.map((svc) => (
          <div class="group premium-card p-6">
            <div class="w-12 h-12 rounded-xl gradient-mesh flex items-center justify-center text-white mb-4">
              <Icon name={svc.icon} size={22} />
            </div>
            <h3 class="font-bold text-lg mb-2">{svc.title}</h3>
            <p class="text-sm text-muted-foreground mb-4 line-clamp-2">{svc.short}</p>
            <a
              href={localizedPath(`/layanan/${svc.slug}`, lang)}
              class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue"
            >
              {t('services_grid.learn_more', lang)} <Icon name="ArrowRight" size={14} />
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
</PublicLayout>
