---
import PublicLayout from '../layouts/PublicLayout.astro';
import Icon from './Icon.astro';
import { t, localizedPath, getServices, getWhatsAppHref, type Lang } from '../data/bms';

interface Props {
  lang?: Lang;
}

const { lang = 'id' } = Astro.props;
const currentPath = localizedPath('/layanan', lang);
const services = getServices(lang);
const waHref = getWhatsAppHref('/layanan', lang);
---

<PublicLayout
  lang={lang}
  currentPath={currentPath}
  title={t('services.seo_title', lang)}
  description={t('services.seo_desc', lang)}
  hideFloatingWa={true}
>
  <section class="relative py-20 md:py-28 overflow-hidden bg-secondary/40">
    <div class="container mx-auto px-4 text-center max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-blue mb-3">
        {t('services_grid.eyebrow', lang)}
      </p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight">
        {t('services_grid.title_a', lang)}{' '}
        <span class="gradient-text">{t('services_grid.title_b', lang)}</span>{' '}
        {t('services_grid.title_c', lang)}
      </h1>
      <p class="mt-4 text-lg text-muted-foreground">
        {t('services_grid.subtitle', lang)}
      </p>
    </div>
  </section>

  <section class="py-20">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((svc) => (
          <div class="group premium-card p-7 flex flex-col justify-between" data-reveal>
            <div>
              <div class="w-14 h-14 rounded-2xl gradient-mesh flex items-center justify-center text-white mb-5 group-hover:scale-110 transition-transform">
                <Icon name={svc.icon} size={26} />
              </div>
              <h2 class="text-xl font-bold mb-2">{svc.title}</h2>
              <p class="text-muted-foreground text-sm leading-relaxed mb-5">{svc.short}</p>
            </div>
            <a
              class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:gap-2 transition-all"
              href={localizedPath(`/layanan/${svc.slug}`, lang)}
            >
              {t('services_grid.learn_more', lang)} <Icon name="ArrowRight" size={14} />
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container mx-auto px-4">
      <div class="relative rounded-3xl bg-brand-navy p-12 md:p-16 text-center overflow-hidden">
        <div class="relative">
          <h2 class="text-3xl md:text-5xl font-extrabold text-white max-w-2xl mx-auto leading-tight">
            {t('cta.title', lang)}
          </h2>
          <p class="mt-4 text-white/80 max-w-xl mx-auto">{t('cta.subtitle', lang)}</p>
          <a
            href={waHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 mt-8 rounded-full bg-white text-brand-navy hover:bg-white/90 font-semibold h-14 px-8"
          >
            {t('cta.button', lang)} <Icon name="ArrowRight" size={18} class="ml-2" />
          </a>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>
