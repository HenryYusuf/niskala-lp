---
import PublicLayout from '../../layouts/PublicLayout.astro';
import Icon from '../../components/Icon.astro';
import { homeInsights, localizedPath, getWhatsAppHref } from '../../data/bms';

export function getStaticPaths() {
  return homeInsights.map((post) => {
    const slug = post.href.replace('/blog/', '');
    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const waHref = getWhatsAppHref('/blog', 'id');
---

<PublicLayout
  lang="id"
  currentPath={post.href}
  title={`${post.anchor} — BMS Services`}
  description={post.description}
>
  <article class="py-20 md:py-28">
    <div class="container mx-auto px-4 max-w-3xl">
      <a
        href={localizedPath('/blog', 'id')}
        class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue mb-6 hover:underline"
      >
        ← Kembali ke Blog
      </a>
      <span class="block text-xs font-semibold uppercase tracking-wider text-brand-blue mb-2">
        Insights · BMS Services
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight leading-tight">
        {post.anchor}
      </h1>
      <p class="mt-6 text-lg text-muted-foreground leading-relaxed">
        {post.description}
      </p>
      <div class="mt-10 premium-card p-8 space-y-4 text-foreground/85 leading-relaxed">
        <p>
          Dalam era transformasi digital yang bergerak cepat, perusahaan membutuhkan sistem yang
          terintegrasi penuh agar pengambilan keputusan dapat dilakukan secara akurat dan real-time.
        </p>
        <p>
          Melalui pendekatan <strong>{post.anchor}</strong>, tim BMS Services membantu bisnis
          merancang arsitektur yang skalabel, aman, dan disesuaikan sepenuhnya dengan proses bisnis
          unik perusahaan Anda.
        </p>
      </div>
      <div class="mt-12 rounded-3xl bg-brand-navy p-8 text-white text-center">
        <h2 class="text-2xl font-bold">Ingin mendiskusikan topik ini untuk bisnis Anda?</h2>
        <a
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 mt-6 rounded-full bg-white text-brand-navy hover:bg-white/90 font-semibold h-12 px-6 text-sm"
        >
          Konsultasi Gratis <Icon name="ArrowRight" size={16} />
        </a>
      </div>
    </div>
  </article>
</PublicLayout>
